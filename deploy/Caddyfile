# Automatic HTTPS (Let's Encrypt) for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# API + health check go to FastAPI; everything else is the React SPA.
	@api path /api/* /health
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format console
	}
}
