# =============================================================
# Roast News - environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env
# =============================================================

# --- Environment ---
# development | production | test
ENVIRONMENT=development

# --- VPS deploy (docker-compose.prod.yml only; see DEPLOY.md) ---
# Public domain, no scheme, e.g. roast.example.com
DOMAIN=
# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels). Secret.
TUNNEL_TOKEN=

# --- Database ---
# Local (non-Docker) connection string. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://roast:change-me-db-password@localhost:5432/roast_news
# Used by the postgres container in docker-compose
POSTGRES_USER=roast
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=roast_news

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# --- Limits & safety ---
RATE_LIMIT_ANON=5/hour
RATE_LIMIT_USER=20/hour
DAILY_ROAST_LIMIT=1000
ROAST_CACHE_HOURS=24
# Salt for hashing client IPs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IP_HASH_SALT=change-me-generate-a-random-salt
# Reverse proxies in front of the API (0 = exposed directly; X-Forwarded-For is then ignored)
TRUSTED_PROXY_COUNT=0

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (Vite, inlined at build time) ---
VITE_API_URL=http://localhost:8000
